# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAA-your-token-here

# Как часто проверять Kwork, в секундах (минимум 30)
CHECK_INTERVAL=60

# Telegram ID пользователей, которым разрешено пользоваться ботом, через запятую.
# Пусто — бот доступен всем. Свой ID можно узнать у @userinfobot
ALLOWED_USERS=

# Путь к файлу базы SQLite
DB_PATH=kwork_bot.db

# Прокси для запросов к kwork.ru, если сервер вне РФ и Kwork его режет
# Пример: http://user:pass@1.2.3.4:8080
KWORK_PROXY=
